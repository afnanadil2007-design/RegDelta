# =============================================================================
# RegDelta environment configuration
# Copy to .env and fill in values. NEVER commit .env (it is gitignored).
# Every variable here is validated at startup by pydantic-settings; a missing
# or malformed required value fails the process fast with a message naming it.
# =============================================================================

# --- Application ---
ENV=development                     # development | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins the API accepts (frontend dev server).
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL 16 + pgvector) ---
# When running via docker-compose the host is the "postgres" service name.
# For local (non-docker) runs use localhost.
POSTGRES_USER=regdelta
POSTGRES_PASSWORD=regdelta
POSTGRES_DB=regdelta
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full async SQLAlchemy URL. If unset it is assembled from the parts above.
# DATABASE_URL=postgresql+psycopg://regdelta:regdelta@localhost:5432/regdelta

# --- Embeddings (sentence-transformers, CPU) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Reranker (cross-encoder, CPU) ---
RERANKER_MODEL=BAAI/bge-reranker-base

# --- Retrieval pipeline ---
# The cross-encoder reranker runs on CPU and scores RETRIEVE_TOP_N passages per
# query. On a weak CPU that is the slow part of a hybrid_rerank search — lower
# RETRIEVE_TOP_N (e.g. 20) for a snappier interactive demo, at a small recall cost.
RRF_K=60                            # Reciprocal Rank Fusion constant
RETRIEVE_TOP_N=50                   # candidates handed to the reranker
RERANK_TOP_K=8                      # results kept after reranking
RELEVANCE_THRESHOLD=0.35            # below this top score => refusal / no-result
# Load the embedding + reranker models once at API startup (in the background)
# instead of lazily on the first request. Keep true for the demo.
WARM_MODELS_ON_STARTUP=true

# --- LLM gateway (provider-agnostic; model pinned here) ---
# Two providers are wired: groq (default, free tier) and anthropic.
# The model strings must match the selected provider.
LLM_PROVIDER=groq                   # groq | anthropic
LLM_MODEL=openai/gpt-oss-20b        # a Groq model id (or e.g. claude-opus-5 for anthropic)
# Vision fallback for low-quality PDF pages. Default is a Groq multimodal model;
# for anthropic set e.g. VISION_MODEL=claude-opus-5.
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
LLM_EFFORT=low                      # low | medium | high | xhigh | max (clamped to high on Groq)
# Caps reasoning + response tokens per call. Kept small: providers reserve this
# whole amount against rate limits, and Groq's free tier allows only 8000
# tokens/minute — a large value blows that budget under the concurrent fan-out.
LLM_MAX_TOKENS=1024
LLM_MAX_RETRIES=3                   # gateway-owned retry budget on transient errors
# Provide only the key for the selected provider; startup validation requires
# the matching one and ignores the other. Get a free Groq key at
# https://console.groq.com/keys — NEVER commit a real key here.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Override only when testing against a Groq-compatible proxy.
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Agent hard limits (all enforced by the graph) ---
MAX_VERIFICATION_RETRIES=2
MAX_ASSESSMENT_TOKENS=200000
ASSESSMENT_TIMEOUT_SECONDS=600

# --- Ingestion ---
SCRAPE_DELAY_SECONDS=2.0            # politeness delay between sebi.gov.in requests
TEXT_QUALITY_THRESHOLD=0.15         # below this a page takes the vision path
VISION_DPI=200
