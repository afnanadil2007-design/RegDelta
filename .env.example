# =============================================================================
# RegDelta environment configuration
# Copy to .env and fill in values. NEVER commit .env (it is gitignored).
# Every variable here is validated at startup by pydantic-settings; a malformed
# value fails the process fast with a message naming it. A missing provider key
# does not stop the app: assessments are reported as unavailable instead.
#
# Precedence on the host (the API and Python tools, Docker Compose's own
# settings such as ports and the project name, and the Vite dev proxy): a
# variable exported in the shell wins over this file, which wins over the
# built-in default. Make does not read this file. The api container is
# different: it receives this file's values, with its database and listen
# settings fixed by docker-compose.yml; shell exports do not reach it.
# =============================================================================

# --- Docker Compose stack ---
# The project that names this checkout's containers and volumes
# (<project>-postgres-1, <project>_pgdata). docker-compose.yml defaults it to
# regdelta-local; change it to keep a second, separate stack. `make stack-check`
# prints what a Compose command will touch and refuses a stack, port or volume
# that belongs to something else.
# COMPOSE_PROJECT_NAME=regdelta-local
# Host port of the containerised web app (`make stack-up`); loopback only.
WEB_PORT=8080

# --- Application ---
ENV=development                     # development | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
# Loopback only: the API has no authentication and can spend money on model
# calls. Docker Compose overrides this inside the container.
API_HOST=127.0.0.1
# `make dev-api` listens here; `make dev-web` proxies /api to it; the Compose
# api service publishes it on 127.0.0.1 too.
API_PORT=8000
# Comma-separated origins the API accepts (frontend dev server).
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL 16 + pgvector) ---
# Two choices:
#  * this checkout's own database: `make up` starts it on 127.0.0.1:POSTGRES_PORT
#    (pick a free port), and the host commands below reach it with these values;
#  * a database you already run: skip `make up` and point these values at it.
# `make db` creates POSTGRES_DB if it is missing and refuses to migrate a
# database that holds tables from something else; `make seed` refuses one that
# holds circulars from outside the synthetic corpus. Inside the Compose stack
# the API always uses the stack's own postgres (host "postgres", port 5432).
POSTGRES_USER=regdelta
POSTGRES_PASSWORD=regdelta
POSTGRES_DB=regdelta
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full async SQLAlchemy URL. If unset it is assembled from the parts above.
# DATABASE_URL=postgresql+psycopg://regdelta:regdelta@localhost:5432/regdelta

# --- Embeddings (sentence-transformers, CPU) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Reranker (cross-encoder, CPU) ---
RERANKER_MODEL=BAAI/bge-reranker-base

# --- Retrieval pipeline ---
# The cross-encoder reranker runs on CPU and scores RETRIEVE_TOP_N passages per
# query; that is the slow part of a hybrid_rerank search. On the evaluation
# laptop 50 took a median of 62 s and 20 took 25.7 s (2026-10-16, 8 queries);
# 20 changed the top 10 on half of them and its recall is unmeasured.
RRF_K=60                            # Reciprocal Rank Fusion constant
RETRIEVE_TOP_N=50                   # candidates handed to the reranker
RERANK_TOP_K=8                      # results kept after reranking
RELEVANCE_THRESHOLD=0.35            # reranked mode only; a sigmoid score, not a calibrated probability
# Load the embedding + reranker models once at API startup (in the background)
# instead of lazily on the first request. Keep true for the demo.
WARM_MODELS_ON_STARTUP=true

# --- LLM gateway (provider-agnostic; model pinned here) ---
# deterministic: rule-based stand-in, offline, free, reproducible; the demo
#                default. Its findings are labelled "rule-based" in the UI.
# groq | anthropic: real model assessments; need the matching key below.
# The model strings must match the selected provider.
LLM_PROVIDER=deterministic          # deterministic | groq | anthropic
LLM_MODEL=openai/gpt-oss-20b        # used by groq/anthropic (e.g. claude-opus-5 for anthropic)
# Vision fallback for low-quality PDF pages. Default is a Groq multimodal model;
# for anthropic set e.g. VISION_MODEL=claude-opus-5.
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
LLM_EFFORT=low                      # low | medium | high | xhigh | max (clamped to high on Groq)
# Caps reasoning + response tokens per call. Kept small: providers reserve this
# whole amount against rate limits, and Groq's free tier allows only 8000
# tokens/minute — a large value blows that budget under the concurrent fan-out.
LLM_MAX_TOKENS=1024
LLM_MAX_RETRIES=3                   # total attempts per call (incl. the first) on transient errors
LLM_MAX_CONCURRENCY=2               # concurrent provider calls per process
# Provide only the key for the selected provider; the other is ignored. Without
# it the app still runs and reports assessments as unavailable. Get a free Groq
# key at https://console.groq.com/keys — NEVER commit a real key here.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Override only when testing against a Groq-compatible proxy.
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Agent hard limits (all enforced by the graph) ---
MAX_VERIFICATION_RETRIES=2
MAX_ASSESSMENT_TOKENS=200000        # checked before every provider call
MAX_ASSESSMENT_CALLS=300            # provider calls per assessment; then CAPPED
ASSESSMENT_TIMEOUT_SECONDS=600      # wall clock; then CAPPED, findings kept

# --- Ingestion ---
SCRAPE_DELAY_SECONDS=2.0            # politeness delay between sebi.gov.in requests
TEXT_QUALITY_THRESHOLD=0.15         # below this a page takes the vision path
VISION_DPI=200
