# Local virtualenvs and their loose artifacts. A `python -m venv` run inside
# backend/ itself scatters these here (Windows: Include/ Lib/ Scripts/; POSIX:
# bin/ include/ lib/ lib64); none of them belong in git. The source tree
# (app/, tests/, alembic/, pyproject.toml …) is NOT ignored.
.venv/
/Include/
/Lib/
/Scripts/
/bin/
/include/
/lib/
/lib64
/share/
pyvenv.cfg

# Build / tool caches
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
mypy_out.txt
