# Secrets
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Node / frontend
node_modules/
frontend/dist/
*.tsbuildinfo

# Model caches. sentence-transformers downloads to ~/.cache/huggingface by
# default; these cover a cache pointed inside the checkout. Anchored to the
# repo root: an unanchored `models/` once matched backend/app/db/models/ and
# kept the ORM package out of git (see docs/maintenance/).
/.cache/
/models/

# Local run artifacts (logs, screenshots, eval scratch output)
/.artifacts/

# Corpus PDFs: synthetic ones are regenerated from the seed, real ones are
# fetched from the regulator. Only the manifests are committed.
/data/synthetic/pdf/
/data/real_sources/pdf/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log


# Loose virtualenv artifacts if a venv is created inside backend/
backend/Include/
backend/Lib/
backend/Scripts/
backend/pyvenv.cfg

# Docker volumes
pgdata/

# Impeccable working files: decision boards and review captures are local;
# PRODUCT.md, DESIGN.md and the surface briefs are the committed record.
/.impeccable/mocks/
/.impeccable/review/
/.impeccable/build/
/.impeccable/live/
/.impeccable/questions/
/.impeccable/*.cache.json
